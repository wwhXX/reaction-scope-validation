{
  "description": "Retrospective prospective batch-by-batch simulations for reaction-boundary discovery. Full labels are used only as an oracle after each simulated batch is selected.",
  "tasks": [
    {
      "name": "aldol_prospective_boundary",
      "type": "prospective_simulation",
      "output_dir": "experiments/results/prospective_boundary_simulation",
      "plot": true,
      "params": {
        "data": "Examples/Sampling_eval/Model_eval/Regression/1700_final_norepeat.csv",
        "target": "conv",
        "non_feature_cols": ["smiles", "conv"],
        "success_threshold": 70,
        "dims": ["2", "64", "128", "full", "tanimoto"],
        "methods": [
          "random",
          "cvt",
          "weighted_itr_cvt",
          "fps",
          "kennard_stone",
          "ward",
          "repulsive_fps",
          "uncertainty",
          "uncertainty_diversity"
        ],
        "budget": 80,
        "batch_size": 10,
        "initial_size": 10,
        "initial_method": "cvt",
        "repeats": 30,
        "boundary_quantile": 0.25,
        "failure_clusters": 8,
        "weighted_iters": 20,
        "cvt_init_iters": 10,
        "uncertainty_trees": 200,
        "candidate_multiplier": 10,
        "diversity_weight": 0.25,
        "out_prefix": "aldol_prospective_boundary_budget80_repeat30"
      }
    },
    {
