{
  "description": "Core Aldol benchmark: dimension-aware modeling, repeated CI, and boundary-sensitive sampling.",
  "tasks": [
    {
      "name": "aldol_dimension_model",
      "type": "dimension_model",
      "output_dir": "experiments/results/aldol_core",
      "plot": true,
      "params": {
        "data": "Examples/Sampling_eval/Model_eval/Regression/1700_final_norepeat.csv",
        "target": "conv",
        "non_feature_cols": ["smiles", "conv"],
        "dims": ["2", "64", "128", "full"],
        "folds": 5,
        "test_size": 0.1,
        "val_size": 0.1,
        "success_threshold": 70,
        "include_xgboost": true,
        "out_prefix": "aldol_dimension_model"
      }
    },
    {
      "name": "aldol_repeated_ci",
      "type": "repeated_ci",
      "output_dir": "experiments/results/aldol_core",
      "plot": true,
      "params": {
        "data": "Examples/Sampling_eval/Model_eval/Regression/1700_final_norepeat.csv",
        "target": "conv",
        "non_feature_cols": ["smiles", "conv"],
        "dims": ["2", "64", "128", "full"],
        "repeats": 30,
        "test_size": 0.2,
        "success_threshold": 70,
        "model_set": "minimal",
        "n_estimators": 150,
        "bootstrap_samples": 2000,
        "out_prefix": "aldol_repeated30_minimal_ci"
      }
    },
    {
      "name": "aldol_boundary_sampling",
      "type": "boundary_sampling",
      "output_dir": "experiments/results/aldol_core",
      "plot": true,
      "params": {
        "data": "Examples/Sampling_eval/Model_eval/Regression/1700_final_norepeat.csv",
        "target": "conv",
        "non_feature_cols": ["smiles", "conv"],
        "success_threshold": 70,
        "dims": ["2", "64", "128", "full"],
        "methods": ["random", "cvt", "fps", "kennard_stone", "ward", "lhs", "sobol", "repulsive_fps"],
        "budget": 40,
        "batch_size": 10,
        "repeats": 5,
        "out_prefix": "aldol_boundary_sampling_budget40_repeat5"
      }
    }
  ]
}
