        "target": "yield",
        "non_feature_cols": ["reaction_id", "yield"],
        "dims": ["2", "16", "32", "full"],
        "repeats": 30,
        "test_size": 0.2,
        "success_threshold": 50,
        "model_set": "minimal",
        "n_estimators": 150,
        "bootstrap_samples": 2000,
        "out_prefix": "suzuki_miyaura_repeated30_minimal_ci"
      }
    }
  ]
}
