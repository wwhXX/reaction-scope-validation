{
  "description": "Chemical Science drawable external full-label benchmark using Buchwald-Hartwig component SMILES and concatenated Morgan fingerprints.",
  "tasks": [
    {
      "name": "buchwald_hartwig_drawable_prospective_boundary",
      "type": "prospective_simulation",
      "output_dir": "experiments/results/chemical_science_drawable_external",
      "plot": true,
      "params": {
        "data": "Data/External/rxn_yields_prepared/buchwald_hartwig_drawable_fp_benchmark.csv",
        "target": "yield",
        "non_feature_cols": [
          "reaction_id",
          "yield",
          "smiles",
          "reaction_smiles",
          "ligand_smiles",
          "additive_smiles",
          "base_smiles",
          "aryl_halide_smiles"
        ],
        "success_threshold": 50,
        "dims": ["2", "32", "64", "full", "tanimoto"],
        "methods": [
          "random",
          "cvt",
          "weighted_itr_cvt",
          "fps",
          "kennard_stone",
          "ward",
          "repulsive_fps",
          "uncertainty",
          "uncertainty_diversity"
        ],
        "budget": 120,
        "batch_size": 20,
        "initial_size": 20,
        "initial_method": "cvt",
        "repeats": 20,
        "boundary_quantile": 0.25,
        "failure_clusters": 8,
        "weighted_iters": 15,
        "cvt_init_iters": 8,
        "uncertainty_trees": 150,
        "candidate_multiplier": 8,
        "diversity_weight": 0.25,
        "out_prefix": "buchwald_hartwig_drawable_prospective_boundary_budget120_repeat20"
      }
    }
  ]
}
